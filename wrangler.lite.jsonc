// Cloudflare Workers config for CARDMIRROR LITE (lite.cardmirror.app)
// — the no-AI / no-internet build variant (src/editor/lite.ts).
// Assets-only, same shape as wrangler.jsonc but serving dist-lite,
// whose build emits the `_headers` file carrying the
// connect-src 'self' Content-Security-Policy (Workers assets honor
// _headers, so the no-egress guarantee ships with the deploy).
// Used by the cardmirror-lite Workers Builds project:
//   build:  npm run build:lite
//   deploy: npx wrangler deploy --config wrangler.lite.jsonc
{
  "name": "cardmirror-lite",
  "compatibility_date": "2026-07-13",
  // One canonical origin (lite.cardmirror.app as a custom domain);
  // workers.dev disabled for the same origin-splitting reason as the
  // main app.
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "directory": "./dist-lite",
    "not_found_handling": "single-page-application"
  }
}
